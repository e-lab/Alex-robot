<?xml version="1.0" encoding="utf-8"?>
<robot name="PurdueAlex003Pedestal">
  <!--
    Purdue Alex003 floor-standing pedestal.
    Origin: center XY of the lower base on the floor.
    Axes: +X forward, +Y left, +Z up. Units: metres and radians.
    The three collision boxes are measured; the remaining primitives are
    photo-guided visual approximations of the Purdue installation.
  -->
  <material name="aluminum">
    <color rgba="0.58 0.61 0.64 1" />
  </material>
  <material name="dark_metal">
    <color rgba="0.055 0.060 0.065 1" />
