                        <joint range="-1.91986 1.22173"/>
                    </default>
                    <default class="alex/shoulder/z/right">
                        <joint range="-1.22173 1.91986"/>
                    </default>
                </default>
            </default>
            <default class="alex/elbow">
                <joint axis="0 1 0" range="-2.35619 0.174532925" armature="0.01"/>
                <position forcerange="-45 45" kp="16"/>
            </default>
            <default class="alex/wrist">
                <position forcerange="-12 12" kp="6"/>
                <default class="alex/wrist/z">
                    <joint axis="0 0 1" range="-2.61799 2.61799" armature="0.01"/>
                </default>
                <default class="alex/wrist/x">
                    <joint axis="1 0 0" armature="0.01"/>
                    <default class="alex/wrist/x/left">
                        <joint range="-1.8326 0.610865"/>
                    </default>
                    <default class="alex/wrist/x/right">
                        <joint range="-0.610865 1.8326"/>
                    </default>
                </default>
            </default>
            <default class="alex/neck">
                <position forcerange="-12 12" kp="6"/>
                <default class="alex/neck/z">
                    <joint axis="0 0 1" range="-1.5708 1.5708" armature="0.01"/>
                </default>
                <default class="alex/neck/y">
                    <joint axis="0 1 0" range="-1.0472 1.0472" armature="0.01"/>
                </default>
            </default>
            <default class="alex/imu">
                <site group="4" rgba="0 0 1 0.4"/>
                <default class="alex/imu/pelvis">
                    <site pos="-0.08687724 0.01225028 -0.08051472"/>
                </default>
                <default class="alex/imu/hip">
                    <default class="alex/imu/hip/left">
                        <site pos="-0.01922309 0.10145013 -0.01488788" euler="-1.570796 0 1.570796"/>
                    </default>
                    <default class="alex/imu/hip/right">
                        <site pos="-0.01922309 -0.07694987 -0.01488788" euler="-1.570796 0 1.570796"/>
                    </default>
                </default>
                <default class="alex/imu/thigh">
                    <default class="alex/imu/thigh/left">
                        <site pos="0.10004 0.03746 -0.21194" euler="1.6947717585 0 1.570796"/>
                    </default>
                    <default class="alex/imu/thigh/right">
                        <site pos="0.10003618 -0.033541826 -0.21194191" euler="1.6947717585 0 1.570796"/>
                    </default>
                </default>
                <default class="alex/imu/shin">
                    <default class="alex/imu/shin/left">
                        <site pos="0.05655120 0.00084826 -0.15664831" euler="1.403695170631842 0 -1.570796"/>
                    </default>
                    <default class="alex/imu/shin/right">
                        <site pos="0.05673025 -0.00875818 -0.15674961" euler="1.403695170631842 0 -1.570796"/>
                    </default>
                </default>
                <default class="alex/imu/foot">
                    <site pos="-0.03575526 0.01180178 -0.04979705"/>
                </default>
                <default class="alex/imu/torso">
                    <site pos="0.04529 -0.02427 0.33757" euler="3.141592 0 0"/>
                </default>
                <default class="alex/imu/head">
                    <site pos="0.040556 -0.014155 0.057016" euler="0.56723 0.0 1.5708"/>
                </default>
                <default class="alex/imu/shoulder_y">
                    <default class="alex/imu/shoulder_y/left">
                        <site pos="0.0174 0.06944 -0.03025" euler="-1.570796 1.570796 0"/>
                    </default>
                    <default class="alex/imu/shoulder_y/right">
                        <site pos="0.0175 -0.0704 -0.00778" euler="1.570796 -1.570796 0"/>
                    </default>
                </default>
                <default class="alex/imu/shoulder_z">
                    <default class="alex/imu/shoulder_z/left">
                        <site pos="-0.00763459 -0.0123324 -0.318" euler="-1.570796 3.1415926 -0.314159"/>
                    </default>
                    <default class="alex/imu/shoulder_z/right">
                        <site pos="0.002 0.016 -0.318" euler="1.570796 0 0.314159"/>
                    </default>
                </default>
                <default class="alex/imu/wrist_z">
                    <default class="alex/imu/wrist_z/left">
                        <site pos="-0.033554 0.010450 -0.148527" euler="1.571 0.0 1.571"/>
                    </default>
                    <default class="alex/imu/wrist_z/right">
                        <site pos="-0.033554 0.010450 -0.148527" euler="1.571 0.0 1.571"/>
                    </default>
                </default>
                <default class="alex/imu/gripper_z">
                    <default class="alex/imu/gripper_z/left">
                        <site pos="0 0 0" euler="0 0 0"/>
                    </default>
                    <default class="alex/imu/gripper_z/right">
                        <site pos="0 0 0" euler="0 0 0"/>
                    </default>
                </default>
            </default>
            <default class="alex/visual">
                <geom contype="0" conaffinity="0" type="mesh"/>
            </default>
            <default class="alex/collision">
                <geom group="3" contype="1" conaffinity="1" rgba="0 1 0 0.4"/>
                <default class="alex/collision/thigh">
                    <geom type="capsule" euler="0 -0.25 0" size="0.095 0.11" condim="3" friction="0.9 0.05 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/foot">
                    <geom type="box" size="0.0985 0.045 0.01" pos="0.045 0.0 -0.0625" condim="3" friction="1.0 0.05 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/pelvis">
                    <geom type="box" size="0.12 0.10 0.07" pos="-0.06 0.0 -0.03" condim="3" friction="0.9 0.05 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/torso">
                    <geom type="capsule" fromto="-0.02 0.0 0.02 -0.02 0.0 0.47" size="0.10" condim="3" friction="0.9 0.05 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/shin">
                    <geom type="capsule" fromto="0.02 0.0 -0.02 0.06 0.0 -0.30" size="0.06" condim="3" friction="0.9 0.05 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/upper_arm">
                    <geom type="capsule" fromto="0 0 0 0.015 0 -0.30" size="0.055" condim="3" friction="0.8 0.04 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/forearm">
                    <geom type="capsule" fromto="0 0 -0.02 0 -0.013 -0.23" size="0.045" condim="3" friction="0.8 0.04 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
                <default class="alex/collision/head">
                    <geom type="sphere" size="0.10" pos="0.04 0.0 0.02" condim="3" friction="0.8 0.04 0.01" solref="0.015 1" solimp="0.9 0.99 0.003"/>
                </default>
            </default>
