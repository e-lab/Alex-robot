    </default>

    <asset>
        <material name="metal" rgba=".9 .95 .95 1"/>
        <material name="black" rgba="0 0 0 1"/>
        <material name="white" rgba="1 1 1 1"/>
        <material name="gray" rgba="0.671705 0.692426 0.774270 1"/>
        <mesh name="left_ankle" file="../meshes/legs/AnklePitchLink.obj"/>
        <mesh name="left_foot" file="../meshes/legs/Foot.obj"/>
        <mesh name="left_hip_x" file="../meshes/legs/LeftHipRollLink.obj"/>
        <mesh name="left_hip_z" file="../meshes/legs/LeftHipYawLink.obj"/>
        <mesh name="left_shin" file="../meshes/legs/LeftShin.obj"/>
        <mesh name="left_thigh" file="../meshes/legs/LeftThigh.obj"/>
        <mesh name="pelvis" file="../meshes/legs/Pelvis.obj"/>
        <mesh name="right_ankle" file="../meshes/legs/AnklePitchLink.obj"/>
        <mesh name="right_foot" file="../meshes/legs/Foot.obj"/>
        <mesh name="right_hip_x" file="../meshes/legs/RightHipRollLink.obj"/>
        <mesh name="right_hip_z" file="../meshes/legs/RightHipYawLink.obj"/>
        <mesh name="right_shin" file="../meshes/legs/RightShin.obj"/>
        <mesh name="right_thigh" file="../meshes/legs/RightThigh.obj"/>
        <mesh name="head" file="../meshes/ALX02_01_A02_HeadLink.obj"/>
        <mesh name="torso" file="../meshes/torso.obj"/>
        <mesh name="left_shoulder_y" file="../meshes/cycloidal_arm/LeftShoulderPitchLink.obj"/>
        <mesh name="left_shoulder_x" file="../meshes/cycloidal_arm/LeftShoulderRollLink_shortBicep.obj"/>
        <mesh name="left_shoulder_z" file="../meshes/cycloidal_arm/LeftShoulderYawLink.obj"/>
        <mesh name="left_elbow_y" file="../meshes/cycloidal_arm/LeftElbowPitchLink.obj"/>
        <mesh name="left_wrist_z" file="../meshes/cycloidal_arm/LeftWristYawLink.obj"/>
        <mesh name="left_wrist_x" file="../meshes/cycloidal_arm/LeftWristRollLink.obj"/>
        <mesh name="left_gripper" file="../meshes/cycloidal_arm/nub.obj" inertia="convex"/>
        <mesh name="right_shoulder_y" file="../meshes/cycloidal_arm/RightShoulderPitchLink.obj"/>
        <mesh name="right_shoulder_x" file="../meshes/cycloidal_arm/RightShoulderRollLink_shortBicep.obj"/>
        <mesh name="right_shoulder_z" file="../meshes/cycloidal_arm/RightShoulderYawLink.obj"/>
        <mesh name="right_elbow_y" file="../meshes/cycloidal_arm/RightElbowPitchLink.obj"/>
        <mesh name="right_wrist_z" file="../meshes/cycloidal_arm/RightWristYawLink.obj"/>
        <mesh name="right_wrist_x" file="../meshes/cycloidal_arm/RightWristRollLink.obj"/>
        <mesh name="right_gripper" file="../meshes/cycloidal_arm/nub.obj" inertia="convex"/>
    </asset>


    <contact>
        <exclude body1="torso" body2="left_shoulder_y"/>
        <exclude body1="torso" body2="right_shoulder_y"/>
        <exclude body1="neck_z" body2="left_shoulder_y"/>
        <exclude body1="neck_z" body2="right_shoulder_y"/>
        <exclude body1="left_shoulder_y" body2="left_shoulder_x"/>
        <exclude body1="left_shoulder_x" body2="left_shoulder_z"/>
        <exclude body1="left_shoulder_z" body2="left_elbow_y"/>
        <exclude body1="left_elbow_y" body2="left_wrist_z"/>
        <exclude body1="left_wrist_z" body2="left_wrist_x"/>
        <exclude body1="left_wrist_x" body2="left_gripper"/>
        <exclude body1="right_shoulder_y" body2="right_shoulder_x"/>
        <exclude body1="right_shoulder_x" body2="right_shoulder_z"/>
        <exclude body1="right_shoulder_z" body2="right_elbow_y"/>
        <exclude body1="right_elbow_y" body2="right_wrist_z"/>
        <exclude body1="right_wrist_z" body2="right_wrist_x"/>
        <exclude body1="right_wrist_x" body2="right_gripper"/>
    </contact>

    <actuator>
        <motor name="left_hip_x" joint="left_hip_x" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_hip_z" joint="left_hip_z" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_hip_y" joint="left_hip_y" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_knee" joint="left_knee_y" gear="80" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_ankle_y" joint="left_ankle_y" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_ankle_x" joint="left_ankle_x" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_hip_x" joint="right_hip_x" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_hip_z" joint="right_hip_z" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_hip_y" joint="right_hip_y" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_knee" joint="right_knee_y" gear="80" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_ankle_y" joint="right_ankle_y" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_ankle_x" joint="right_ankle_x" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="spine_z" joint="spine_z" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_shoulder_y" joint="left_shoulder_y" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_shoulder_x" joint="left_shoulder_x" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_shoulder_z" joint="left_shoulder_z" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_elbow" joint="left_elbow_y" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_wrist_z" joint="left_wrist_z" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="left_wrist_x" joint="left_wrist_x" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="neck_z" joint="neck_z" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="neck_y" joint="neck_y" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_shoulder_y" joint="right_shoulder_y" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_shoulder_x" joint="right_shoulder_x" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_shoulder_z" joint="right_shoulder_z" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_elbow" joint="right_elbow_y" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_wrist_z" joint="right_wrist_z" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_wrist_x" joint="right_wrist_x" gear="10" ctrllimited="true" ctrlrange="-1 1"/>
    </actuator>

    <sensor>
        <!-- Pelvis IMU: -->
         <gyro name="imu_pelvis_gyro" site="imu_pelvis"/>
         <accelerometer name="imu_pelvis_accelerometer" site="imu_pelvis"/>

        <!-- Left Hip IMU: -->
         <gyro name="imu_left_hip_gyro" site="imu_left_hip"/>
         <accelerometer name="imu_left_hip_accelerometer" site="imu_left_hip"/>

         <!-- Left Thight IMU: -->
        <gyro name="imu_left_thigh_gyro" site="imu_left_thigh"/>
        <accelerometer name="imu_left_thigh_accelerometer" site="imu_left_thigh"/>

        <!-- Left Shin IMU: -->
        <gyro name="imu_left_shin_gyro" site="imu_left_shin"/>
        <accelerometer name="imu_left_shin_accelerometer" site="imu_left_shin"/>

        <!-- Left Foot IMU: -->
        <gyro name="imu_left_foot_gyro" site="imu_left_foot"/>
        <accelerometer name="imu_left_foot_accelerometer" site="imu_left_foot"/>

        <!-- Right Hip IMU: -->
         <gyro name="imu_right_hip_gyro" site="imu_right_hip"/>
         <accelerometer name="imu_right_hip_accelerometer" site="imu_right_hip"/>

         <!-- Right Thight IMU: -->
        <gyro name="imu_right_thigh_gyro" site="imu_right_thigh"/>
        <accelerometer name="imu_right_thigh_accelerometer" site="imu_right_thigh"/>

        <!-- Right Shin IMU: -->
        <gyro name="imu_right_shin_gyro" site="imu_right_shin"/>
        <accelerometer name="imu_right_shin_accelerometer" site="imu_right_shin"/>

        <!-- Right Foot IMU: -->
        <gyro name="imu_right_foot_gyro" site="imu_right_foot"/>
        <accelerometer name="imu_right_foot_accelerometer" site="imu_right_foot"/>

        <!-- Torso IMU: -->
        <gyro name="imu_torso_gyro" site="imu_torso"/>
        <accelerometer name="imu_torso_accelerometer" site="imu_torso"/>

        <!-- Head IMU: -->
        <gyro name="imu_head_gyro" site="imu_head"/>
        <accelerometer name="imu_head_accelerometer" site="imu_head"/>

        <!-- Left Shoulder Pitch IMU: -->
        <gyro name="imu_left_shoulder_y_gyro" site="imu_left_shoulder_y"/>
        <accelerometer name="imu_left_shoulder_y_accelerometer" site="imu_left_shoulder_y"/>

        <!-- Left Shoulder Yaw IMU: -->
        <gyro name="imu_left_shoulder_z_gyro" site="imu_left_shoulder_z"/>
        <accelerometer name="imu_left_shoulder_z_accelerometer" site="imu_left_shoulder_z"/>

        <!-- Left Wrist Yaw IMU: -->
        <gyro name="imu_left_wrist_z_gyro" site="imu_left_wrist_z"/>
        <accelerometer name="imu_left_wrist_z_accelerometer" site="imu_left_wrist_z"/>
        
        <!-- Right Shoulder Pitch IMU: -->
        <gyro name="imu_right_shoulder_y_gyro" site="imu_right_shoulder_y"/>
        <accelerometer name="imu_right_shoulder_y_accelerometer" site="imu_right_shoulder_y"/>

        <!-- Right Shoulder Yaw IMU: -->
        <gyro name="imu_right_shoulder_z_gyro" site="imu_right_shoulder_z"/>
        <accelerometer name="imu_right_shoulder_z_accelerometer" site="imu_right_shoulder_z"/>

        <!-- Right Wrist Yaw IMU: -->
        <gyro name="imu_right_wrist_z_gyro" site="imu_right_wrist_z"/>
        <accelerometer name="imu_right_wrist_z_accelerometer" site="imu_right_wrist_z"/>

        <!-- Additional Sensors for training: -->
        <!-- Pelvis IMU: -->
        <framequat name="imu_pelvis_orientation" objtype="site" objname="imu_pelvis"/>
        <velocimeter name="imu_pelvis_linear_velocity" site="imu_pelvis"/>
        <framepos name="imu_pelvis_position" objtype="site" objname="imu_pelvis"/>

        <!-- Globals: -->
        <framezaxis name="upvector" objtype="site" objname="imu_pelvis"/>
        <framexaxis name="forwardvector" objtype="site" objname="imu_pelvis"/>
        <framelinvel name="global_linear_velocity" objtype="site" objname="imu_pelvis"/>
        <frameangvel name="global_angular_velocity" objtype="site" objname="imu_pelvis"/>
        <framelinvel name="left_foot_global_linear_velocity" objtype="site" objname="left_foot_site"/>
        <framelinvel name="right_foot_global_linear_velocity" objtype="site" objname="right_foot_site"/>
    </sensor>

</mujoco>
