<mujoco model="alex_v1_full_body">
    <compiler angle="radian" eulerseq="XYZ" meshdir="." autolimits="true" balanceinertia="true"/>

    <option iterations="3" ls_iterations="5" timestep="0.002" integrator="Euler">
        <flag eulerdamp="disable"/>
    </option>

    <default>
        <default class="alex">
            <joint damping="15" frictionloss="0.0"/>
            <position inheritrange="2" dampratio="2"/>
