            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:displacement
                token outputs:surface
            }
        }

        def Material "material_BrushedIron_AlbedoTransparency"
        {
            token outputs:displacement.connect = </Dining_Table_21_2/Materials/material_BrushedIron_AlbedoTransparency/PreviewSurface.outputs:displacement>
            token outputs:surface.connect = </Dining_Table_21_2/Materials/material_BrushedIron_AlbedoTransparency/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Dining_Table_21_2/Materials/material_BrushedIron_AlbedoTransparency/DiffuseTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:displacement
                token outputs:surface
            }

            def Shader "DiffuseTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (1, 1, 1, 1)
                asset inputs:file = @./Textures/BrushedIron_AlbedoTransparency.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "auto"
                float2 inputs:st.connect = </Dining_Table_21_2/Materials/material_BrushedIron_AlbedoTransparency/Primvar_st_float2.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Primvar_st_float2"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

