        {
            token outputs:displacement.connect = </Dining_Table_21_2/Materials/material_WhiteMetal/PreviewSurface.outputs:displacement>
            token outputs:surface.connect = </Dining_Table_21_2/Materials/material_WhiteMetal/PreviewSurface.outputs:surface>

