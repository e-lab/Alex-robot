# LA-7 stdin script — drive Alex to the stove using scan().
#
# One-decision strategy:
#  Turn 1: if stove is already in scene_graph, goto. Otherwise
#          scan(target='stove') — the autonomy loop rotates the body
#          continuously until SAM3 grounds the stove, then clears
#          scan_active. The agent's gate is closed during the scan
#          so this turn "blocks" until the rotation completes (no
#          mid-rotation re-decisions).
#  Turn 2: scan completed. If found, goto. Otherwise fail honestly.
#  Turn 3: while goto is walking, the FSM is APPROACH so the gate is
#          closed. Turn 3 only fires after ARRIVED. Declare success.

```python
# Turn 1: act on what we see, or start scanning for the target.
nodes = list_scene()["value"]
print("la7 t1 seen:", [(n["label"], n["world_xy"]) for n in nodes])
target = None
for label in ("stove", "oven"):
    r = find(label)
    if r["status"] == "ok":
        target = label
        break
if target is not None:
    goto(target)
else:
    # Continuous rotation that early-exits when stove appears.
    scan(target_label="stove", max_revolutions=1.0)
```
EOF

```python
# Turn 2: the scan either found stove (last_action shows found=True)
# or exhausted its budget. Either way we re-check and act.
nodes = list_scene()["value"]
print("la7 t2 seen:", [(n["label"], n["world_xy"]) for n in nodes])
for label in ("stove", "oven"):
    r = find(label)
    if r["status"] == "ok":
        goto(label)
        break
else:
    fail("scan completed without finding stove; saw " + str([n["label"] for n in nodes]))
```
EOF

```python
# Turn 3: goto walked us to the goal. Declare success.
finish("LA-7: scan-and-goto complete")
```
EOF
